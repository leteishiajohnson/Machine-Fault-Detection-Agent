# Machine Fault Diagnosis Agent — Environment Configuration
#
# Copy this file to .env and fill in your actual credentials.
# The .env file must NEVER be committed to version control.
# The agent works without any API key using the built-in rule-based reasoner.
#
# Reasoner priority (when USE_LLM=true):
#   1. IBM watsonx.ai (Granite)  — if WATSONX_API_KEY + WATSONX_PROJECT_ID are set
#   2. OpenAI-compatible         — if OPENAI_API_KEY is set
#   3. Rule-based fallback       — always available (no credentials required)


# ===========================================================================
# IBM watsonx.ai — IBM Cloud SaaS (preferred)
# ===========================================================================
#
# Get your API key: https://cloud.ibm.com/iam/apikeys
# Get your Project ID from your watsonx.ai project settings.
# Regional endpoint options:
#   https://us-south.ml.cloud.ibm.com   (Dallas)
#   https://eu-de.ml.cloud.ibm.com      (Frankfurt)
#   https://eu-gb.ml.cloud.ibm.com      (London)
#   https://jp-tok.ml.cloud.ibm.com     (Tokyo)
#   https://au-syd.ml.cloud.ibm.com     (Sydney)
#
WATSONX_API_KEY=your-ibm-cloud-api-key-here
# IBM Cloud account email / IAM username (optional — required by some SDK configurations)
WATSONX_USERNAME=your-ibm-cloud-email@example.com
WATSONX_PROJECT_ID=your-watsonx-project-id-here
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# API / platform version passed to the SDK (e.g. 5.2 for newer watsonx.ai instances)
WATSONX_VERSION=5.2

# Granite model ID — available models on IBM Cloud SaaS (as of 2025):
#   ibm/granite-3-8b-instruct       (recommended — best accuracy)
#   ibm/granite-3-2b-instruct       (faster, lighter)
#   ibm/granite-3-8b-instruct       (default)
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct


# ===========================================================================
# IBM Cloud Pak for Data (CP4D) — on-premises deployment
# ===========================================================================
#
# Use these INSTEAD of the SaaS variables above.
# Presence of WATSONX_CPD_URL activates CP4D authentication mode.
#
# WATSONX_CPD_URL=https://your-cpd-instance.example.com
# WATSONX_CPD_USERNAME=your-cpd-username
# WATSONX_CPD_PASSWORD=your-cpd-password
# WATSONX_PROJECT_ID=your-watsonx-project-id-here
# WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
#
# Alternatively, use an API key instead of username/password:
# WATSONX_CPD_APIKEY=your-cpd-api-key


# ===========================================================================
# OpenAI-compatible (fallback — used if watsonx.ai is not configured)
# ===========================================================================
#
# OPENAI_API_KEY=sk-...your-key-here...
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_BASE=                      # leave blank for OpenAI default


# ===========================================================================
# Application settings
# ===========================================================================
#
# Set to "false" to force rule-based reasoner even when credentials are set.
# USE_LLM=true
